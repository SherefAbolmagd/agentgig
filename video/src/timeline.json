  },
  {
   "start": 88.26041671244303,
   "end": 91.66041671244304,
   "text": "Sent from Sam's Gmail",
   "sub": "Only after Sam's tap"
  },
  {
   "start": 94.31391674486795,
   "end": 97.71391674486796,
   "text": "A customer emails",
   "sub": "Nobody forwards it"
  },
  {
   "start": 98.76291666237512,
   "end": 102.16291666237512,
   "text": "Found in Shopify",
   "sub": "Tracking included"
  },
  {
   "start": 115.84091677872337,
   "end": 119.24091677872337,
