 "captions": [
  {
   "start": 0.4,
   "end": 6.664712837837839,
   "text": "A new order lands on Shopify, and seconds later Sam's phone already knows what to do next."
  },
  {
   "start": 6.714712837837839,
   "end": 8.138145833333333,
   "text": "Nobody typed a thing."
  },
  {
   "start": 9.188145833333333,
   "end": 13.680361208920187,
   "text": "AgentGig gives you AI agents that do the small jobs of running a shop."
  },
  {
   "start": 13.730361208920188,
   "end": 18.352354166666668,
   "text": "Each one starts when something happens, and you approve from your phone."
  },
  {
   "start": 19.802354166666667,
   "end": 24.176406773743018,
   "text": "Meet Sam, who runs Willow and Wick, an online candle shop."
  },
  {
   "start": 24.22640677374302,
   "end": 26.159602770018623,
   "text": "Sam has hired five agents."
  },
  {
   "start": 26.209602770018623,
   "end": 29.82088768621974,
   "text": "Inventory Guardian watches new orders and stock."
  },
  {
   "start": 29.870887686219742,
   "end": 33.55844937150839,
   "text": "Order Desk answers customers and handles refunds."
  },
  {
   "start": 33.608449371508385,
   "end": 36.68579690409684,
   "text": "Payment Rescue follows up declined cards."
  },
  {
   "start": 36.73579690409684,
   "end": 39.5080373603352,
   "text": "ReceiptHero checks supplier invoices."
  },
  {
   "start": 39.5580373603352,
   "end": 42.71166166201118,
   "text": "And Quote Builder prices wholesale orders."
  },
  {
   "start": 42.76166166201118,
   "end": 47.05943750000001,
   "text": "They share one memory, so what one learns, they all know."
  },
  {
   "start": 48.7094375,
   "end": 57.05323519392034,
   "text": "On the website, Sam sees the team and what starts each agent, the memory they share, and a marketplace to hire more."
  },
  {
   "start": 57.103235193920334,
   "end": 60.16472916666667,
   "text": "Sam pays in tokens, only for finished work."
  },
  {
   "start": 61.61472916666667,
   "end": 63.56050971283784,
   "text": "Sam linked Telegram once."
  },
  {
   "start": 63.61050971283784,
   "end": 69.38818890765766,
   "text": "Ada, the team's supervisor, brings every draft to Sam's phone to approve."
  },
  {
   "start": 69.43818890765766,
   "end": 71.22430701013513,
   "text": "Sam never types a task."
  },
  {
   "start": 71.27430701013513,
   "end": 73.37975,
   "text": "Here's one day at the shop."
  },
  {
   "start": 74.82975000000002,
   "end": 75.67738872832372,
   "text": "Nine o'clock:"
  },
  {
   "start": 75.72738872832372,
   "end": 77.26551878612719,
   "text": "a new order on Shopify."
  },
  {
   "start": 77.31551878612719,
   "end": 84.51567774566476,
   "text": "Inventory Guardian sees it leaves just two Fig and Cedar candles, and writes the reorder to the supplier."
  },
  {
   "start": 84.56567774566476,
   "end": 86.72525000000002,
   "text": "Sam taps approve, and it's sent."
  },
  {
   "start": 93.81900005197525,
   "end": 95.07694031746198,
   "text": "A customer emails:"
  },
  {
   "start": 95.12694031746197,
   "end": 96.31221723486611,
   "text": "where's my order?"
  },
  {
   "start": 96.36221723486611,
   "end": 101.97995838530859,
   "text": "Order Desk finds it in Shopify, with tracking, and replies in the same thread."
  },
  {
   "start": 111.03725019550322,
   "end": 113.3512982724263,
   "text": "Emma's candle arrived cracked."
  },
  {
   "start": 113.4012982724263,
   "end": 117.60658481088784,
   "text": "Order Desk finds her payment in Stripe and asks first."
  },
  {
   "start": 117.65658481088784,
   "end": 121.23145852883655,
   "text": "One tap refunds her, and the apology goes out."
  },
  {
   "start": 135.1967501029968,
   "end": 137.21690653574532,
   "text": "A card is declined at checkout."
  },
  {
   "start": 137.26690653574533,
   "end": 142.75958343633013,
   "text": "Payment Rescue sends a kind note with a fresh payment link, so the sale isn't lost."
  },
  {
   "start": 154.86350010490418,
   "end": 157.48020238031788,
   "text": "A supplier invoice lands in Google Drive."
  },
  {
   "start": 157.5302023803179,
   "end": 163.98435427157082,
   "text": "ReceiptHero reads it, code checks every sum, and a twenty-two pound overcharge is caught and logged."
  },
  {
   "start": 177.74925008869172,
   "end": 180.4556570107347,
   "text": "A homeware shop emails for forty gift sets."
  },
  {
   "start": 180.50565701073472,
   "end": 185.64795842202503,
   "text": "Quote Builder prices them from Sam's list, and remembers this customer pays late."
  },
  {
   "start": 195.4787502512932,
   "end": 196.39079758139027,
   "text": "And the bill?"
  },
  {
   "start": 196.44079758139029,
   "end": 201.5710524357592,
   "text": "Tokens are held when work starts and charged only when it's delivered."
  },
  {
   "start": 201.62105243575922,
   "end": 203.0511252512932,
   "text": "Failed work is free."
  },
  {
   "start": 204.50112525129322,
   "end": 219.23624132272178,
   "text": "Under the hood, one gateway on Cloud Run runs every task through verify, reserve, scrub, ground, run and deliver, with Gemini on Vertex AI, Firestore and Memory Bank."
  },
  {
   "start": 219.2862413227218,
   "end": 220.03784400129322,
   "text": "AgentGig:"
  },
  {
   "start": 220.08784400129323,
   "end": 223.15518775129323,
   "text": "AI employees that work as one team."
  }
 ],
 "callouts": [
  {
   "start": 4.794250094890593,
   "end": 8.194250094890593,
   "text": "New Shopify order → Sam's phone in seconds",
   "sub": "No one typed a task"
  },
  {
   "start": 49.509437500000004,
   "end": 52.9094375,
   "text": "What starts each agent",
   "sub": "Chosen when Sam hires it"
  },
  {
   "start": 53.70893733358383,
   "end": 57.10893733358383,
   "text": "One memory for the whole team",
   "sub": "Customer and money facts need Sam's OK"
  },
  {
   "start": 57.02143745279312,
   "end": 60.42143745279312,
   "text": "Hire more from the marketplace",
   "sub": "Paid per finished task"
  },
  {
   "start": 62.21472916666667,
   "end": 65.61472916666668,
   "text": "Link Telegram once",
   "sub": "Ada brings every draft to Sam's phone"
  },
  {
   "start": 80.43825005149841,
   "end": 83.83825005149842,
   "text": "Fig & Cedar down to 2",
   "sub": "Reorder to Calder Candle Co. written"
  },
  {
   "start": 88.25050004577636,
   "end": 91.65050004577637,
   "text": "Sent from Sam's Gmail",
   "sub": "Only after Sam's tap"
  },
  {
   "start": 94.30400007820128,
   "end": 97.70400007820129,
   "text": "A customer emails",
   "sub": "Nobody forwards it"
  },
  {
   "start": 98.75299999570845,
   "end": 102.15299999570846,
   "text": "Found in Shopify",
   "sub": "Tracking included"
  },
  {
   "start": 115.8310001120567,
   "end": 119.2310001120567,
   "text": "Refund £24.00?",
   "sub": "Only the cracked candle, never more than was paid"
  },
  {
   "start": 125.26325028991695,
