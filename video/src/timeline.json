   "sub": "Customer and money facts need Sam's OK"
  },
  {
   "start": 57.02143745279312,
   "end": 60.42143745279312,
   "text": "Hire more from the marketplace",
   "sub": "Paid per finished task"
  },
  {
   "start": 62.21472916666667,
   "end": 65.61472916666668,
   "text": "Link Telegram once",
   "sub": "Ada brings every draft to Sam's phone"
  },
  {
   "start": 80.44816671816507,
   "end": 83.84816671816507,
   "text": "Fig & Cedar down to 2",
