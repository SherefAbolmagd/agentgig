 "captions": [
  {
   "start": 13.960666592915853,
   "end": 17.82995269613555,
   "text": "Running an online shop means a hundred small jobs every week."
  },
  {
   "start": 17.87995269613555,
   "end": 25.21877075958252,
   "text": "AgentGig gives you AI agents that do them, paid per finished task, working as one team you can run from your phone."
  },
  {
   "start": 26.668770759582518,
   "end": 31.390934308335353,
   "text": "This is Sam, who runs Willow and Wick, an online candle store."
  },
  {
   "start": 31.440934308335354,
   "end": 37.933416592915854,
   "text": "Sam's team has agents for orders, stock, money and customers, all sharing one memory."
  },
  {
   "start": 39.38341659291585,
   "end": 43.8482437393805,
   "text": "Every morning at seven, Inventory Guardian checks stock in Shopify."
  },
  {
   "start": 43.8982437393805,
   "end": 50.452020759582524,
   "text": "Fig and Cedar is nearly gone, so it drafts the reorder, and the email waits in Gmail for Sam's OK."
  },
  {
   "start": 60.509416631698606,
   "end": 61.51031406759604,
   "text": "Sam just asks."
  },
  {
   "start": 61.56031406759604,
   "end": 63.53704483682681,
   "text": "Revenue Pulse reads Stripe:"
  },
  {
   "start": 63.587044836826806,
   "end": 67.29024996503193,
   "text": "this week's takings, and a card that was declined."
  },
  {
   "start": 72.85341660563151,
   "end": 74.12299715025094,
   "text": "Need something new?"
  },
  {
   "start": 74.17299715025094,
   "end": 74.67861001114332,
   "text": "Hire it."
  },
  {
   "start": 74.72861001114332,
   "end": 81.62377077229817,
   "text": "Win-back works in Sam's Shopify store, asks before it emails anyone, and has a monthly spending cap."
  },
  {
   "start": 84.71241657320658,
   "end": 93.83202073987324,
   "text": "It finds four customers who haven't ordered since the summer and writes each one a personal email, only to people who agreed to hear from the shop."
  },
  {
   "start": 99.37041651789347,
   "end": 101.78917247027444,
   "text": "A homeware shop wants forty gift sets."
  },
  {
   "start": 101.83917247027443,
   "end": 109.78014568456015,
   "text": "Quote Builder prices every line from Sam's wholesale list, volume discounts included, and saves the quote as a Gmail draft."
  },
  {
   "start": 124.52274988873799,
   "end": 127.46155955278685,
   "text": "A supplier invoice lands in Google Drive."
  },
  {
   "start": 127.51155955278685,
   "end": 138.39622905540463,
   "text": "ReceiptHero picks it up on its own, Gemini reads it, code checks every sum, and a twenty-two pound overcharge is caught and logged to the spend sheet."
  },
  {
   "start": 159.37308305486044,
   "end": 162.6956106990912,
   "text": "Agents learn as they work, and they write down what they learn."
  },
  {
   "start": 162.7456106990912,
   "end": 167.67410388819374,
   "text": "Facts about customers and money wait for Sam's OK, and once approved, every agent knows them."
  },
  {
   "start": 173.46074975713097,
   "end": 175.76408660170026,
   "text": "Sam invites Priya as a manager."
  },
  {
   "start": 175.81408660170027,
   "end": 180.16710392379764,
   "text": "Priya can approve drafts too, but only Sam can buy tokens."
  },
  {
   "start": 182.2027498601278,
   "end": 185.38054773246822,
   "text": "Any developer can sell their own agent here."
  },
  {
   "start": 185.43054773246823,
   "end": 192.4963748601278,
   "text": "LabelWise registers its candle label checker, five live checks pass, and it's in the marketplace."
  },
  {
   "start": 193.9463748601278,
   "end": 194.78212081482036,
   "text": "And the bill?"
  },
  {
   "start": 194.83212081482037,
   "end": 199.55152210931874,
   "text": "Tokens are held when work starts and charged only when it's delivered."
  },
  {
   "start": 199.60152210931875,
   "end": 200.91420819346112,
   "text": "Failed work is free."
  },
  {
   "start": 202.36420819346114,
   "end": 216.3679855744135,
   "text": "Under the hood, one gateway on Cloud Run runs every task through verify, reserve, scrub, ground, run and deliver, with Gemini on Vertex AI, Firestore and Memory Bank."
  },
  {
   "start": 216.4179855744135,
   "end": 217.12993736012777,
   "text": "AgentGig:"
  },
  {
   "start": 217.17993736012778,
   "end": 220.0930831934611,
   "text": "AI employees that work as one team."
  }
 ],
 "callouts": [
  {
   "start": 1,
   "end": 4.4,
   "text": "A customer asks: where's my order?",
   "sub": "Sam forwards it to Ada on Telegram"
  },
  {
   "start": 6.007666619618734,
   "end": 9.407666619618734,
   "text": "Found in Shopify, reply drafted",
   "sub": "Shipped · Royal Mail tracking included"
  },
  {
   "start": 27.76877075958252,
   "end": 31.168770759582518,
   "text": "One team for the whole shop",
   "sub": "Orders · stock · money · customers"
  },
  {
   "start": 40.183416592915854,
   "end": 43.58341659291585,
   "text": "Runs by itself every morning",
   "sub": "Started by hand for the demo"
  },
  {
   "start": 46.52041664505005,
   "end": 49.92041664505005,
   "text": "Two products running low",
   "sub": "Reorder email drafted"
  },
  {
   "start": 60.10941663169861,
   "end": 63.509416631698606,
   "text": "Waiting in Gmail",
   "sub": "Nothing is sent without Sam"
  },
  {
   "start": 69.94741656366983,
   "end": 73.34741656366984,
   "text": "This week's takings from Stripe",
   "sub": "And one declined card"
  },
  {
   "start": 73.9534166056315,
   "end": 77.35341660563151,
   "text": "Hired in seconds",
   "sub": "Works in Sam's Shopify · 30-token monthly cap"
  },
  {
   "start": 91.08441659990946,
   "end": 94.48441659990947,
   "text": "4 customers to win back",
   "sub": "Only those who opted in to emails"
  },
  {
   "start": 109.8007498620351,
   "end": 113.20074986203511,
   "text": "Priced from Sam's own list",
   "sub": "Volume discounts applied"
  },
  {
   "start": 127.390750014623,
   "end": 130.790750014623,
   "text": "Lands in Google Drive",
   "sub": "The folder is checked every 5 minutes"
  },
  {
   "start": 144.70408323987326,
   "end": 148.10408323987326,
   "text": "£22.00 overcharge caught",
   "sub": "Gemini reads it · code checks the sums"
  },
  {
   "start": 166.47608307584127,
   "end": 169.87608307584128,
   "text": "Memory with a human check",
   "sub": "Customer and money facts need an OK"
  },
  {
   "start": 181.8027498601278,
   "end": 185.2027498601278,
   "text": "Roles for the whole team",
   "sub": "Managers approve · the owner pays"
  },
  {
   "start": 188.15874983851117,
   "end": 191.55874983851118,
   "text": "Five live checks, then listed",
   "sub": "Partners earn 80% of the tokens"
  },
  {
   "start": 198.8557082163493,
   "end": 202.25570821634932,
   "text": "Charged only for finished work",
   "sub": "Failed tasks are free"
  }
 ],
