# Copy to .env.local and fill in. Server values are read by lib/env.ts.

# --- Google Cloud (server) ---
GOOGLE_CLOUD_PROJECT=agentexchange-hackathon
# Bill local API calls to this project (read by google-auth-library)
GOOGLE_CLOUD_QUOTA_PROJECT=agentexchange-hackathon
# Region for Vertex AI calls
GOOGLE_CLOUD_LOCATION=us-central1
# "(default)" or a named Firestore database
FIRESTORE_DATABASE_ID=(default)
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
# api = Cloud DLP, local = regex fallback
DLP_MODE=api
# true lets requests use an `x-demo-user: demo-cafe-lumen` header instead of
# signing in. Local and demo use only; never on a public deployment.
DEMO_AUTH=true
# Cloud Storage bucket for uploaded company knowledge (Milestone 2)
KNOWLEDGE_BUCKET=agentexchange-hackathon-knowledge

# --- Firebase web app (client) — Firebase console > Project settings > Your apps ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=(default)
# Invoice inbox bucket (uploads trigger ReceiptHero)
# Local dev uses its own bucket with no Pub/Sub notification, so production never sees local files
INBOX_BUCKET=agentexchange-hackathon-inbox-dev
# Set on Cloud Run only: public URL and the service account used for OIDC
# APP_URL=https://...run.app
# PUBLIC_URL=https://agentgig.si
# TASKS_SERVICE_ACCOUNT=agentexchange-app@PROJECT.iam.gserviceaccount.com

# --- Real integrations (each switches on when set; push to prod with `npm run push:secrets`) ---
STRIPE_SECRET_KEY=
# Filled in by `npm run push:secrets` (creates the Stripe webhook endpoint)
STRIPE_WEBHOOK_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Xero: developer.xero.com → New app (Web app), redirect URI <APP_URL>/api/connections/xero/callback
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# QuickBooks: developer.intuit.com → Create app (Accounting scope), redirect URI <APP_URL>/api/connections/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# sandbox (default) or production
QUICKBOOKS_ENV=sandbox
# Shopify, WooCommerce, Stripe (owner data), Mailchimp and HubSpot need no app keys: owners paste their own in Connections.
# Deadline Keeper: free key from developer.company-information.service.gov.uk (REST key)
COMPANIES_HOUSE_API_KEY=
# Sign-in connections (register an app with each vendor; redirect URI <APP_URL>/api/connections/<provider>/callback)
# Microsoft 365: entra.microsoft.com → App registrations → New (any org + personal accounts); delegated Graph permissions
#   offline_access, User.Read, Mail.ReadWrite, Calendars.Read
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Square: developer.squareup.com → Applications → OAuth
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
# sandbox (default) or production
SQUARE_ENV=sandbox
# Zoho CRM: api-console.zoho.com → Server-based Applications
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# FreshBooks: my.freshbooks.com/#/developer → Create an app
FRESHBOOKS_CLIENT_ID=
FRESHBOOKS_CLIENT_SECRET=
# Sage Accounting: developer.sage.com → Create app
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
# Calendly, Acuity, Pipedrive, Typeform, Jotform, Trello, Asana, Notion and PayPal need no app keys: owners paste their own.
