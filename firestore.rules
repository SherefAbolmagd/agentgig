rules_version = '2';

// Clients may read their own account's data live; every write goes through
// API routes using the Admin SDK, which bypasses these rules. Nobody can edit
// their own balance from the browser.
//
// An account is an organization. Its owner's uid is its ID; teammates have a
// memberships/{uid} doc pointing at it, and read its documents as their own.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function acct() {
      let m = /databases/$(database)/documents/memberships/$(request.auth.uid);
      return exists(m) ? get(m).data.accountId : request.auth.uid;
    }
    function owns(data) { return signedIn() && data.userId == acct(); }

    match /agents/{slug} {
      allow read: if resource.data.status == 'listed';
    }

    match /users/{uid} {
      allow read: if signedIn() && acct() == uid;
    }

    match /memberships/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || resource.data.accountId == acct());
    }
    match /invites/{token} {
      allow read: if signedIn() && resource.data.accountId == acct();
    }

    match /hires/{id}              { allow read: if owns(resource.data); }
    match /connections/{id}        { allow read: if owns(resource.data); }
    // The dashboard subscribes to tasks/{accountId}_{key} before the task
    // exists, so a missing doc is readable when its ID starts with the account ID.
    match /tasks/{id} {
      allow read: if resource == null
        ? signedIn() && id.matches(acct() + '_.+')
        : owns(resource.data);
    }
    match /token_transactions/{id} { allow read: if owns(resource.data); }
    match /approvals/{id}          { allow read: if owns(resource.data); }
    match /knowledge_sources/{id}  { allow read: if owns(resource.data); }
    match /memory/{id}             { allow read: if owns(resource.data); }

    match /{document=**} {
      allow write: if false;
    }
  }
}
